# Ignore folder contents, keep .gitkeep for structure
/crm-tg-app/*
!/crm-tg-app/.gitkeep

/crm-tg-app-backend/*
!/crm-tg-app-backend/.gitkeep

/crm-tg-app-postgress/*
!/crm-tg-app-postgress/.gitkeep

/crm-tg-app-postgress/*
!/crm-tg-app-postgress/.gitkeep

/nginx/*
!/nginx/.gitkeep

# Docker data (postgres, pgadmin) — не коммитить
/data/

# Compose secrets (Postgres, pgAdmin, WSS)
/.env
/.env.example
/compose.env