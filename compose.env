# Пример для pgAdmin (env_file в docker-compose). Синхронизируй с корневым `.env` или скопируй оттуда PGADMIN_* и POSTGRES_*.
# Реальные секреты не коммить — используй `.env` в корне (gitignore).

POSTGRES_USER=crm_pg_app
# Опционально; совпадай с корневым .env или оставь пустым — compose подставит дефолт
POSTGRES_PASSWORD=
POSTGRES_DB=app

PGADMIN_DEFAULT_EMAIL=pgadmin+local@crm.internal
PGADMIN_DEFAULT_PASSWORD=localdev_replace_pgadmin_password

# Опционально; docker-compose подставит дефолт для локальной разработки
WSS_SHARED_SECRET=

S3_BUCKET_ENDPOINT=s3.ru-7.storage.selcloud.ru
S3_BUCKET_PUBLIC=af162ba4f65540ca8a9ce1dd7fbe4bb8
S3_BUCKET_SECRET=f2648ae54686411f8de5066dd914ed29
S3_BUCKET_REGION=ru-7
S3_BUCKET_NAME=s3-devtbookflow