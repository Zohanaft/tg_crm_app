# Необязательно: без `.env` docker-compose подставит значения по умолчанию (см. compose.env и docker-compose.yml).
# Свои секреты: скопируй compose.env → `.env` или задай только нужные ключи.
# Generate passwords:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# ВАЖНО: POSTGRES_USER/POSTGRES_PASSWORD применяются только при ПЕРВОМ создании data-dir.
# При `docker compose up` сервис postgres-role-sync сам переименует admin/postgres → POSTGRES_USER
# и выставит пароль (нужен Docker Compose v2.20+ для condition: service_completed_successfully).
# Вручную: sh scripts/postgres-migrate-role.sh
# Либо удалите ./crm-tg-app-postgress/postgres и поднимите стек заново (данные БД пропадут).
#
# pgAdmin: PGADMIN_DEFAULT_* задаёт только ПЕРВЫЙ запуск. Сменили email/пароль в compose —
# старый логин остаётся в volume pgadmin_data. Сброс: docker volume rm <проект>_pgadmin_data
# Первый запуск pgAdmin (пустой volume): см. compose.env (email + пароль).

POSTGRES_USER=crm_pg_app
POSTGRES_PASSWORD=
POSTGRES_DB=app

PGADMIN_DEFAULT_EMAIL=pgadmin+local@crm.internal
PGADMIN_DEFAULT_PASSWORD=

WSS_SHARED_SECRET=
