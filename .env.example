# Скопируй в корень проекта как `.env` (файл в .gitignore). Обязательно смени значения для любой среды, кроме чисто локальной.
# Генерация: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#
# POSTGRES_* применяются при первом создании data-dir Postgres. Смена пароля после инициализации — отдельная процедура.
# pgAdmin: PGADMIN_DEFAULT_* только при первом запуске пустого volume.

POSTGRES_USER=crm_pg_app
# Необязательно: в docker-compose.yml задан слабый дефолт для локалки. Для прод — свой пароль; при уже созданном volume пароль должен совпадать с тем, что был при init.
POSTGRES_PASSWORD=
POSTGRES_DB=app

PGADMIN_DEFAULT_EMAIL=pgadmin+local@crm.internal
PGADMIN_DEFAULT_PASSWORD=localdev_replace_pgadmin_password

# Необязательно для docker compose: есть слабый дефолт в docker-compose.yml. В проде задай свой.
WSS_SHARED_SECRET=

# Прод: обязательно сильный секрет (не значение по умолчанию из кода).
JWT_SECRET=localdev_replace_jwt_secret

# Опционально: CORS для API, если фронт на другом origin (через запятую).
# CORS_ORIGIN=https://app.example.com,https://www.example.com
